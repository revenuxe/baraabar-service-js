NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SITE_URL=https://www.baraabar.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only restricted Auth account; never give this account the admin role.
SUPABASE_BACKEND_EMAIL=
SUPABASE_BACKEND_PASSWORD=
# Independent random secret, at least 32 characters; used only to hash rate-limit identifiers.
REQUEST_BUDGET_SECRET=
# Set COOKIE_SECURE=false only when running production mode over local HTTP.
# Production HTTPS deployments should leave COOKIE_SECURE unset.
